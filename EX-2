67. Add Binary
=========================================================
char* addBinary(char* a, char* b) {
    int i = strlen(a) - 1;
    int j = strlen(b) - 1;
    int carry = 0;
    int max_len = (i > j ? i : j) + 3; 
    char* res = (char*)malloc(max_len * sizeof(char));
    int k = 0;

    while (i >= 0 || j >= 0 || carry) {
        if (i >= 0) {
            carry += a[i] - '0';
            i--;
        }
        if (j >= 0) {
            carry += b[j] - '0';
            j--;
        }
        res[k++] = (carry % 2) + '0';
        carry /= 2;
    }
    res[k] = '\0';
    for (int left = 0, right = k - 1; left < right; left++, right--) {
        char temp = res[left];
        res[left] = res[right];
        res[right] = temp;
    }

    return res;
}

