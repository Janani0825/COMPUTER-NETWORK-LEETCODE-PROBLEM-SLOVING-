898. Bitwise ORs of Subarrays
================================================================
int compare(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    int* globalUnique = (int*)malloc(32 * arrSize * sizeof(int));
    int globalSize = 0;
    int currentEnds[32]; 
    int size = 0;

    for (int i = 0; i < arrSize; i++) {
        int num = arr[i];
        int nextEnds[32];
        int nextSize = 0;

        nextEnds[nextSize++] = num;
        globalUnique[globalSize++] = num;

        for (int j = 0; j < size; j++) {
            int nextOr = currentEnds[j] | num;
            if (nextOr != nextEnds[nextSize - 1]) {
                nextEnds[nextSize++] = nextOr;
                globalUnique[globalSize++] = nextOr;
            }
        }
        size = nextSize;
        for (int j = 0; j < size; j++) {
            currentEnds[j] = nextEnds[j];
        }
    }
    qsort(globalUnique, globalSize, sizeof(int), compare);

    if (globalSize == 0) {
        free(globalUnique);
        return 0;
    }
    int uniqueCount = 1;
    for (int i = 1; i < globalSize; i++) {
        if (globalUnique[i] != globalUnique[i - 1]) {
            uniqueCount++;
        }
    }

    free(globalUnique);
    return uniqueCount;
}
