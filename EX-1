476. Number Complement
================================================================
int findComplement(int num) {
    if (num == 0) return 1; 
    unsigned int bit = num;
    bit |= bit >> 1;   
    bit |= bit >> 2;   
    bit |= bit >> 4;   
    bit |= bit >> 8;   
    bit|= bit >> 16;  
    return num ^ bit;
}
